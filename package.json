{
  "name": "claude-usage-pebble",
  "version": "1.1.1",
  "description": "A tiny always-on-top Claude usage widget for Windows, macOS and Linux, with six layouts.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "screenshots": "electron docs/capture.js",
    "icon": "electron scripts/make-icon.js"
  },
  "build": {
    "appId": "com.claudeusagepebble.app",
    "productName": "Claude Usage Pebble",
    "artifactName": "${name}-${os}-${arch}.${ext}",
    "files": [
      "main.js",
      "preload.js",
      "widget.html"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Claude Usage Pebble",
      "artifactName": "${name}-${os}-${arch}-setup.${ext}"
    },
    "icon": "build/icon.png"
  },
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "gifenc": "^1.0.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mu-ki/claude-usage-pebble.git"
  },
  "homepage": "https://github.com/mu-ki/claude-usage-pebble"
}
